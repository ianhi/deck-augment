# Copy to .env and fill in your key. .env is gitignored.

# Google AI Studio key for Gemini API. Used by Phase 2 sentence generation
# and (later) any Gemini-driven passes (typo flagging, smart Notes filtering).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default model. Default is gemini-3-flash-preview:
# better form-constraint adherence and collocations than gemini-2.5-flash
# (per the QA pass in out/experiment_*.jsonl). Avoid the pro tiers.
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_MODEL=gemini-2.5-flash   # cheaper but flatter

# Google Cloud Text-to-Speech API key for Phase 3 audio generation.
# Distinct from GEMINI_API_KEY because Cloud TTS may be enabled on a
# different GCP project. Get one at:
#   https://console.cloud.google.com/apis/credentials
# and ensure the Cloud Text-to-Speech API is enabled on its project.
GOOGLE_CLOUD_TTS_API_KEY=
